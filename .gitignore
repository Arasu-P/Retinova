# ==============================================================================
# Retinova - Git Ignore Configuration
# Comprehensive exclusions for sensitive files, node_modules, large models & data
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12
credentials.json
secrets.json

# ------------------------------------------------------------------------------
# 2. Node & JavaScript / TypeScript Dependencies & Builds
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
.turbo/
.cache/
**/cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 4. Large ML Models, Weights, and Checkpoints (>100MB / non-source)
# ------------------------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.onnx
*.pkl
*.pickle
**/checkpoints/
**/models/checkpoints/

# Large MATLAB data dumps and matrices
*.mat
attribution_matrix.mat
**/Module6_*_Result.mat

# ------------------------------------------------------------------------------
# 5. Datasets & Raw Medical Imagery
# ------------------------------------------------------------------------------
data/
**/data/
dataset/
**/dataset/
**/raw_images/
**/EyePACS/
**/Messidor/
**/APTOS/
**/IDRiD/

# ------------------------------------------------------------------------------
# 6. Uploads, Test Outputs & Generated Reports
# ------------------------------------------------------------------------------
**/uploads/*
!**/uploads/.gitkeep
**/report_*.html
**/test_card_*.png
gradcam_overlay.png
gradcam_raw.png

# ------------------------------------------------------------------------------
# 7. Experiment Results & Benchmarks
# ------------------------------------------------------------------------------
**/results/
**/evaluation/
**/sanity_check/
**/manifest/

# ------------------------------------------------------------------------------
# 8. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*.swo
*~
scratch/
**/scratch/

# ------------------------------------------------------------------------------
# 9. IDE, OS & Editor Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln

# ------------------------------------------------------------------------------
# 10. Accidental Artifacts
# ------------------------------------------------------------------------------
*Department of Consumer Affairs*
*Indian law*
*mandatory requirement*
*source documents*
*specifically intended*
*Report Automation System*
*instruments (NAWIs)*
*umer Affairs*
*ystem must be able*
