# NetraAI Platform Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=netra-ai-rural-dr-secret-key-2026
JWT_EXPIRES_IN=7d

# Relational Database URL (Optional: defaults to local store if Postgres is unset)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netra_ai

# AI Inference Service Engine ('mock' or 'matlab')
AI_SERVICE_TYPE=matlab
MATLAB_SERVICE_URL=http://localhost:9910/api/v1/matlab-ai

# Simulation Service Engine ('mock' or 'matlab')
SIMULATION_SERVICE_TYPE=matlab
MATLAB_SIMULINK_URL=http://localhost:9920/api/v1/simulink

# File Upload Storage Path
STORAGE_PATH=./uploads

# CORS Configuration
CORS_ORIGIN=*
